{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "north",
        "lit": "true"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon_lamp"
      }
    },
    {
      "when": {
        "facing": "east",
        "lit": "true"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon_lamp",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "lit": "true"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon_lamp",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "true"
      },
      "apply": {
        "model": "radiocraft:block/adsb_beacon_lamp",
        "y": 270
      }
    }
  ]
}
